NODE_ENV=development
PORT=5000

# database
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# optional: separate database used by the test suite
DATABASE_URL_TEST="postgresql://user:password@host:5432/dbname_test?schema=public"

# auth
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="24h"
JWT_ISSUER="acm-bidding-platform"
BCRYPT_SALT_ROUNDS=10

# bootstrap admin account (auto-seeded on startup if it does not exist)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin-password-here"

CORS_ORIGIN="*"
