NODE_ENV=development
PORT=5000

# database
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"
# optional: separate database used by the test suite
DATABASE_URL_TEST="postgresql://user:password@host:5432/dbname_test?schema=public"

# runtime database limits (seconds); explicit URL parameters take precedence
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=3
DB_QUERY_TIMEOUT_SECONDS=3
# cooperative request budget and maximum wait for the game mutation queue
OPERATION_TIMEOUT_MS=10000
GAME_QUEUE_WAIT_MS=3000

# auth
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="24h"
JWT_ISSUER="acm-bidding-platform"
BCRYPT_SALT_ROUNDS=10

# bootstrap admin account (auto-seeded on startup if it does not exist)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin-password-here"

CORS_ORIGIN="*"
