  "description": "Backend for Bid and Code hackathon bidding platform with real-time WebSockets and dynamic multiplier scoring",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "pretest": "npm run prisma:migrate:test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate:test": "node scripts/migrate-test-db.js",
    "prisma:studio": "prisma studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdZard69/acm-bidding-platform-backend.git"
  },
  "keywords": [
